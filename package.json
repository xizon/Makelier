{
    "name": "makelier",
    "version": "1.1.92",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "workspaces": [
        "sites/*"
    ],
    "scripts": {
        "test:core": "vitest run --config vitest.config.ts",
        "dev": "tsx core/cli/index.ts dev",
        "build": "tsx core/cli/index.ts build",
        "preview": "tsx core/cli/index.ts preview",
        "export:react": "tsx core/cli/index.ts export:react",
        "export:wp": "tsx core/cli/index.ts export:wp",
        "typecheck": "tsc --noEmit",
        "prefix:tailwind": "tsx core/auto-cli/security/prefix-tailwind.ts",
        "create:component": "tsx core/auto-cli/create/component.ts",
        "create:page": "tsx core/auto-cli/create/page.ts",
        "create:site": "tsx core/auto-cli/create/site.ts",
        "tmpl:build": "tsx tools/template-releases/scripts/build.ts",
        "tmpl:publish": "tsx tools/template-releases/scripts/publish.ts",
        "build:wp-editor": "tsx core/export/wordpress/build-editor.ts"
        
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@types/adm-zip": "^0.5.8",
        "@types/node": "^22.20.5",
        "@types/three": "^0.177.0",
        "@wordpress/block-editor": "^20.1.0",
        "@wordpress/blocks": "^17.2.0",
        "@wordpress/components": "^45.0.0",
        "@wordpress/element": "^10.2.0",
        "adm-zip": "^0.6.1",
        "cssnano": "^8.0.10",
        "cssnano-preset-lite": "^5.0.6",
        "happy-dom": "^21.0.4",
        "magic-string": "^1.4.5",
        "marked": "^18.2.1",
        "oxc-parser": "^0.158.0",
        "parse5": "^8.1.1",
        "postcss": "^8.5.33",
        "postcss-nesting": "^14.0.3",
        "postcss-value-parser": "^4.2.0",
        "preact": "^11.1.1",
        "preact-render-to-string": "^6.8.2",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.5",
        "ts-morph": "^28.0.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "unified": "^11.0.5",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    }
}
